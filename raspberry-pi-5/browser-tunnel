#!/bin/bash
# Run on the Pi as the SSH login user, with an SSH local forward to browser.sock.
set -euo pipefail
umask 077
dir="$HOME/.cache/rpi-setup"
mkdir -p -- "$dir"
chmod 700 -- "$dir"
exec 9>"$dir/browser.lock"
flock -n 9 || { echo "Another browser tunnel is already running." >&2; exit 1; }
socket="$dir/browser.sock"
cert=$(mktemp "$dir/public-cert.XXXXXXXX")
trap 'rm -f -- "$socket" "$cert"' EXIT
rm -f -- "$socket"

# Only the public certificate is needed to authenticate the loopback TLS peer.
public_cert=/etc/rpi-setup/cert.pem
if [[ -r "$public_cert" ]]; then
    cat "$public_cert" > "$cert"
else
    sudo /usr/bin/cat "$public_cert" > "$cert"
fi
host="$(hostname -s).local"
openssl x509 -in "$cert" -noout -checkhost "$host" >/dev/null
echo 'Open http://127.0.0.1:8088/ on your laptop. Press Ctrl-C here to close the tunnel.'
systemd-socket-activate --listen="$socket" --accept --inetd \
    /usr/bin/openssl s_client -quiet -connect 127.0.0.1:8443 \
    -servername "$host" -verify_hostname "$host" -verify_return_error -CAfile "$cert"

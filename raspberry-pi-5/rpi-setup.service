[Unit]
Description=Raspberry Pi SSH fallback hotspot
Wants=NetworkManager.service ssh.service
After=NetworkManager.service

[Service]
User=rpi-setup
Group=rpi-setup
ExecStart=/usr/bin/python3 -B /usr/local/lib/rpi-setup/hotspot.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
